@model PlaywrightSandbox.Web.Models.Game
@{ ViewData["Title"] = Model.Title; }

<h1>@Model.Title</h1>
<hr/>

<dl class="row">
    <dt class="col-sm-3">Genre</dt>
    <dd class="col-sm-9" id="detail-genre">@Model.Genre</dd>

    <dt class="col-sm-3">Release Year</dt>
    <dd class="col-sm-9" id="detail-year">@Model.ReleaseYear</dd>

    <dt class="col-sm-3">Rating</dt>
    <dd class="col-sm-9" id="detail-rating">@Model.Rating / 10</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9" id="detail-description">@Model.Description</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
